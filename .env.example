# ==========================================
# FACE VERIFICATION (Phase 14)
# Nilai default DIBACA dari school_settings (face_verification_enabled,
# face_match_threshold) supaya bisa diubah admin tanpa redeploy. Env
# di bawah ini hanya fallback/dokumentasi kalau school_settings belum
# di-seed (lihat database/migrations/004_add_new_settings.sql).
# ==========================================
FACE_VERIFICATION_ENABLED=false
FACE_MATCH_THRESHOLD=0.6


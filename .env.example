# ==========================================
# SERVER
# ==========================================
NODE_ENV=development
PORT=3000

# ==========================================
# DATABASE (Railway MySQL)
# Diisi nanti di Phase 6 setelah database dibuat di Railway.
# Mapping dari variable Railway (MYSQLHOST, dst) akan dijelaskan
# di Phase 6 / Phase 26.
# ==========================================
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ==========================================
# JWT
# JWT_SECRET akan digenerate di Phase 7 (jangan pakai nilai default).
# ==========================================
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ==========================================
# EMAIL PROVIDER
# Provider final akan ditentukan di Phase 12 setelah perbandingan
# free-tier terkini. Placeholder di bawah untuk beberapa kandidat.
# ==========================================
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# ==========================================
# GEOFENCING (opsional, diaktifkan di Phase 14)
# ==========================================
GPS_VALIDATION_ENABLED=false
SCHOOL_LATITUDE=
SCHOOL_LONGITUDE=
SCHOOL_RADIUS_METERS=

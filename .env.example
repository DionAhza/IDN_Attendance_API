# ==========================================
# SERVER
# ==========================================
NODE_ENV=development
PORT=3000

# ==========================================
# DATABASE (Railway MySQL)
# Diisi nanti di Phase 6 setelah database dibuat di Railway.
# Mapping dari variable Railway (MYSQLHOST, dst) akan dijelaskan
# di Phase 6 / Phase 26.
# ==========================================
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ==========================================
# JWT
# JWT_SECRET akan digenerate di Phase 7 (jangan pakai nilai default).
# ==========================================
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ==========================================
# EMAIL PROVIDER (Phase 12)
# Provider: 'smtp' (Nodemailer + Gmail App Password) — default untuk dev.
# Bisa diganti ke 'resend'/'brevo' nanti tanpa ubah kode di luar
# notification.service.js.
#
# Cara setup Gmail App Password:
# 1. Nyalakan 2-Step Verification di akun Google.
# 2. Buka https://myaccount.google.com/apppasswords
# 3. Buat App Password untuk "Mail" → copy 16 karakter.
# 4. Isi EMAIL_SMTP_PASS dengan 16 karakter itu (tanpa spasi).
# ==========================================
EMAIL_PROVIDER=smtp
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=

# ==========================================
# MULTI-CHANNEL NOTIFICATION (Phase 13)
# NOTIFICATION_CHANNELS: daftar channel aktif, comma-separated, dari
# {email, whatsapp}. Kosong = default "email" saja (kompatibel dengan
# setup sebelum Phase 13).
# Contoh aktifkan keduanya: NOTIFICATION_CHANNELS=email,whatsapp
# ==========================================
NOTIFICATION_CHANNELS=email,wha

# ==========================================
# WHATSAPP — FONNTE (Phase 13)
# Fonnte (https://fonnte.com) adalah gateway WhatsApp API Indonesia.
# Tidak perlu approval WhatsApp Business resmi — cukup scan QR sekali
# di dashboard Fonnte untuk connect device, lalu copy token device-nya.
#
# Cara setup:
# 1. Daftar & login di https://fonnte.com
# 2. Tambah device baru, scan QR pakai WhatsApp yang mau dipakai kirim.
# 3. Buka menu Device, copy "Token" device tersebut.
# 4. Isi FONNTE_TOKEN dengan token itu, lalu tambahkan "whatsapp" ke
#    NOTIFICATION_CHANNELS di atas.
#
# Nomor tujuan diambil dari kolom `parents.phone` — pastikan diisi
# dengan format Indonesia (boleh diawali 0 atau 62, dirapikan otomatis
# oleh notification.service.js sebelum dikirim ke Fonnte).
# ==========================================
FONNTE_TOKEN=geJgdQsMdtUhQiNgJ6zV
FONNTE_API_URL=https://api.fonnte.com/send

# ==========================================
# GEOFENCING (opsional, diaktifkan di Phase 14)
# ==========================================
GPS_VALIDATION_ENABLED=false
SCHOOL_LATITUDE=
SCHOOL_LONGITUDE=
SCHOOL_RADIUS_METERS=

# ==========================================
# FACE VERIFICATION (Phase 14)
# Nilai default DIBACA dari school_settings (face_verification_enabled,
# face_match_threshold) supaya bisa diubah admin tanpa redeploy. Env
# di bawah ini hanya fallback/dokumentasi kalau school_settings belum
# di-seed (lihat database/migrations/004_add_new_settings.sql).
# ==========================================
FACE_VERIFICATION_ENABLED=false
FACE_MATCH_THRESHOLD=0.6

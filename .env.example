# ==========================================
# SERVER
# ==========================================
NODE_ENV=development
PORT=3000

# ==========================================
# DATABASE (Railway MySQL)
# Diisi nanti di Phase 6 setelah database dibuat di Railway.
# Mapping dari variable Railway (MYSQLHOST, dst) akan dijelaskan
# di Phase 6 / Phase 26.
# ==========================================
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ==========================================
# JWT
# JWT_SECRET akan digenerate di Phase 7 (jangan pakai nilai default).
# ==========================================
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ==========================================
# EMAIL PROVIDER (Phase 12)
# Provider: 'smtp' (Nodemailer + Gmail App Password) — default untuk dev.
# Bisa diganti ke 'resend'/'brevo' nanti tanpa ubah kode di luar
# notification.service.js.
#
# Cara setup Gmail App Password:
# 1. Nyalakan 2-Step Verification di akun Google.
# 2. Buka https://myaccount.google.com/apppasswords
# 3. Buat App Password untuk "Mail" → copy 16 karakter.
# 4. Isi EMAIL_SMTP_PASS dengan 16 karakter itu (tanpa spasi).
# ==========================================
EMAIL_PROVIDER=smtp
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=

# ==========================================
# GEOFENCING (opsional, diaktifkan di Phase 14)
# ==========================================
GPS_VALIDATION_ENABLED=false
SCHOOL_LATITUDE=
SCHOOL_LONGITUDE=
SCHOOL_RADIUS_METERS=
